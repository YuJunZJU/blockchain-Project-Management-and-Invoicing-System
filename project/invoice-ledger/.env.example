# 复制为 .env 后填写。不要把 .env 提交到 GitHub。
# 阿里云 RAM 用户的 AccessKey；需要 OCR 的 RecognizeAllText 权限。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OCR_REGION=cn-hangzhou

# 可选：任意 OpenAI 兼容大模型的纠偏接口。
# 例如阿里云百炼兼容模式：https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CORRECTION_BASE_URL=
AI_CORRECTION_API_KEY=
AI_CORRECTION_MODEL=
